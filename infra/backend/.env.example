# =============================================================================
# Backend environment variables — EXAMPLE
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit the real `.env` (it contains secrets).
# Every value below is a placeholder or empty on purpose.
# =============================================================================

# ── Keycloak (identity provider) ─────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
REALM=your-realm
KEYCLOAK_CLIENT_ID=backend-client
KEYCLOAK_CLIENT_SECRET=
# Optional extra realms as a JSON array (empty = only the default REALM).
# e.g. [{"name":"acme","keycloak_url":"http://keycloak:8080","realm":"ACME","client_id":"backend-client-acme","client_secret":"..."}]
EXTRA_REALMS=

# ── Session / JWT ────────────────────────────────────────────────────────────
SECRET_KEY=
ALGORITHM=HS256
SESSION_EXPIRE_HOURS=24
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_ACTIVITY_FLUSH_SECONDS=60

# ── URLs ─────────────────────────────────────────────────────────────────────
BACKEND_URL=http://backend:8000
FRONTEND_URL=https://your-frontend.example.com
# Public portal URL used in emails/links. Empty = fall back to FRONTEND_URL.
PORTAL_URL=https://your-portal.example.com
# Allowed CORS origins (JSON array or comma-separated).
CORS_ORIGINS=["http://localhost:5173"]

# ── Company identity / white-label ───────────────────────────────────────────
# Brand shown in emails/UI. Empty = company settings row → COMPANY_NAME → DEFAULT_BRAND_NAME.
COMPANY_NAME=
BRAND_NAME=
DEFAULT_BRAND_NAME=Attendance Portal
# Optional override for the public-holiday ICS feed. Empty = per-country default.
HOLIDAY_ICS_URL=

# ── Cookie security ──────────────────────────────────────────────────────────
COOKIE_SECURE=True

# ── Cloudflare Turnstile (bot protection) ────────────────────────────────────
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=False

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@pgbouncer:6432/dbname
# Pooling is normally pgbouncer's job (null). Use "queue" for a client-side pool.
DB_POOL_CLASS=null
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# ── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_PER_SECOND=10

# ── Redmine integration ──────────────────────────────────────────────────────
REDMINE_URL=http://redmine:3000
REDMINE_API_KEY=

# ── MinIO / S3 (file storage) ────────────────────────────────────────────────
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=recordings
MINIO_ASSETS_BUCKET=company-assets
MINIO_REGION=us-east-1

# ── SMTP / email ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ENABLED=False

# ── Password reset ───────────────────────────────────────────────────────────
RESET_TOKEN_EXPIRE_MINUTES=15

# ── OpenTelemetry (distributed tracing → Tempo) ──────────────────────────────
OTEL_SERVICE_NAME=attendance-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# ── Reverse proxy ────────────────────────────────────────────────────────────
FORWARDED_ALLOW_IPS=

# ── Log alert emails (used by scripts/logdash.service) ───────────────────────
LOG_ALERT_HOST=smtp.gmail.com
LOG_ALERT_PORT=587
LOG_ALERT_USER=
LOG_ALERT_PASS=
LOG_ALERT_TO=
