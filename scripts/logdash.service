[Unit]
Description=logdash — internal log dashboard
Documentation=https://github.com/your-org/backend-monorepo/scripts/logdash.py
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=app-backend
WorkingDirectory=/home/app-backend/backend-monorepo/scripts
ExecStart=/usr/bin/python3 /home/app-backend/backend-monorepo/scripts/logdash.py
Restart=always
RestartSec=5

Environment="LOG_ALERT_HOST=smtp.gmail.com"
Environment="LOG_ALERT_PORT=587"
Environment="LOG_ALERT_USER=manishk@variyaslabs.com"
Environment="LOG_ALERT_PASS=dywz pvob mouz zazf"
Environment="LOG_ALERT_TO=manishk@variyaslabs.com"

ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=logdash

[Install]
WantedBy=multi-user.target
